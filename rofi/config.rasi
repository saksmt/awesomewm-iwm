configuration {
    window-format: "{c} {t}";

    display-combi: "*";
    display-drun: "C";
    display-window: "W";

    modi-combi: "window,drun";
    modi: "combi,window,drun";
    show-icons: true;
    /* don't forget to update nix/packages/awesome-iwm-rofi-config.nix it patches terminal */
    terminal: "kitty";
    run-shell-command: "{terminal} -e 'sh -c \"{cmd}; zsh -il\"'";
    click-to-exit: true;
    combi-hide-mode-prefix: true;
    kb-clear-line: "Shift+Delete";
    kb-move-front: "Home";
    kb-move-end: "End";
    kb-remove-word-forward: "Control+Delete";
    kb-delete-entry: "Alt+Delete";
    kb-mode-next: "Tab";
    kb-mode-previous: "Shift+Tab";
    kb-row-tab: "";
    kb-row-first: "Ctrl+Home";
    kb-row-last: "Ctrl+End";
    kb-element-next: "";
}

@theme "theme"
